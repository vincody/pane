{
  "name": "pane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:ui": "playwright test",
    "dev": "npm run build && node --watch server/index.js"
  },
  "overrides": {
    "dompurify": "$dompurify"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
