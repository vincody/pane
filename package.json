{
  "name": "pane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "start": "node --import tsx server/src/index.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:ui": "playwright test --config config/playwright/web.config.ts",
    "dev": "npm run build && node --import tsx --watch server/src/index.ts",
    "typecheck": "tsc -p config/typescript/client.json && tsc -p config/typescript/server.json && tsc -p config/typescript/tests.json && tsc -p config/typescript/desktop.json",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --dir --win --x64 --publish never",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "npm run desktop:build && playwright test --config config/playwright/desktop.config.ts"
  },
  "overrides": {
    "dompurify": "$dompurify"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.10",
    "entities": "^8.1.0",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild": true,
    "electron@44.7.2": true
  },
  "main": "desktop-build/main.mjs",
  "description": "A local workspace for AI coding terminals, files and Git.",
  "author": "vincody"
}
